<Window x:Class="SimpleSerialTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Serial Tester" Width="1140" Height="760" MinWidth="940" MinHeight="580"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource BgBrush}">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 接続 -->
            <Border Style="{StaticResource Card}" Padding="14,10">
                <DockPanel LastChildFill="True">
                    <Button x:Name="ConnectButton" DockPanel.Dock="Right" MinWidth="92" Margin="12,0,0,0"
                            Command="{Binding ToggleConnectCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Content" Value="接続" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Content" Value="切断" />
                                        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 状態 -->
                    <Border DockPanel.Dock="Right" CornerRadius="13" Padding="10,3" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource InfoBgBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="#E4F3EF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource FaintBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionText}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource SubTextBrush}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsDisconnected}">
                        <TextBlock Text="ポート" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="214" ItemsSource="{Binding Ports}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding SelectedPortName}" />
                        <Button Content="更新" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                Command="{Binding RefreshPortsCommand}" ToolTip="ポートの一覧を読み直す" />

                        <TextBlock Text="ボーレート" Style="{StaticResource FieldLabel}" Margin="16,0,6,0" />
                        <ComboBox Width="92" IsEditable="True" ItemsSource="{Binding BaudRates}"
                                  Text="{Binding BaudRateText, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="データ" Style="{StaticResource FieldLabel}" Margin="14,0,6,0" />
                        <ComboBox Width="50" ItemsSource="{Binding DataBitsChoices}" SelectedItem="{Binding DataBits}" />

                        <TextBlock Text="パリティ" Style="{StaticResource FieldLabel}" Margin="14,0,6,0" />
                        <ComboBox Width="86" ItemsSource="{Binding ParityChoices}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding Parity}" />

                        <TextBlock Text="ストップ" Style="{StaticResource FieldLabel}" Margin="14,0,6,0" />
                        <ComboBox Width="56" ItemsSource="{Binding StopBitsChoices}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding StopBits}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 本体 -->
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：履歴・登録リスト・マクロ -->
                <Border Style="{StaticResource Card}">
                    <TabControl x:Name="SideTabs" Margin="4,2,4,6">

                        <TabItem Header="履歴">
                            <DockPanel Margin="8,8,8,4">
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="2,0,0,6"
                                           Text="クリックで入力欄へ。ダブルクリックでそのまま送信。入力欄では ↑↓ でもたどれます。" />
                                <Button DockPanel.Dock="Bottom" Content="履歴を消す" Style="{StaticResource SmallButton}"
                                        HorizontalAlignment="Right" Margin="0,6,0,0" Command="{Binding ClearHistoryCommand}" />
                                <ListBox x:Name="HistoryList" ItemsSource="{Binding History}"
                                         SelectedItem="{Binding SelectedHistory}"
                                         ItemContainerStyle="{StaticResource RowItem}"
                                         MouseDoubleClick="HistoryList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <DockPanel.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="送信する" Click="HistorySend_Click" />
                                                        <MenuItem Header="入力欄へ写す" Click="HistoryUse_Click" />
                                                        <MenuItem Header="コピー" Click="HistoryCopy_Click" />
                                                        <Separator />
                                                        <MenuItem Header="登録リストへ追加" Click="HistoryAddFavorite_Click" />
                                                        <MenuItem Header="履歴から消す" Click="HistoryRemove_Click" />
                                                    </ContextMenu>
                                                </DockPanel.ContextMenu>
                                                <Border x:Name="hexTag" DockPanel.Dock="Left" Style="{StaticResource HexTag}" Visibility="Collapsed">
                                                    <TextBlock Text="HEX" FontSize="10" Foreground="{StaticResource SubTextBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding Data}" FontFamily="{StaticResource MonoFont}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Data}" />
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsHex}" Value="True">
                                                    <Setter TargetName="hexTag" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="登録リスト">
                            <DockPanel Margin="8,8,8,4">
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="2,0,0,6"
                                           Text="よく送るものに名前を付けて残します。ダブルクリックで送信。" />

                                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="入力欄から追加" Style="{StaticResource SmallButton}" Command="{Binding AddFavoriteCommand}" />
                                        <Button Content="削除" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Command="{Binding RemoveFavoriteCommand}" />
                                        <Button Content="↑" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Command="{Binding MoveFavoriteUpCommand}" ToolTip="上へ" />
                                        <Button Content="↓" Style="{StaticResource SmallButton}" Margin="4,0,0,0" Command="{Binding MoveFavoriteDownCommand}" ToolTip="下へ" />
                                    </StackPanel>

                                    <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="8" Background="#F7F9FC"
                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                            IsEnabled="{Binding HasSelectedFavorite}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="6" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="6" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="名前" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Column="1" Text="{Binding SelectedFavorite.Name, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Row="2" Text="中身" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="2" Grid.Column="1" FontFamily="{StaticResource MonoFont}"
                                                     Text="{Binding SelectedFavorite.Data, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Grid.Row="4" Grid.Column="1" Content="HEXとして送る" IsChecked="{Binding SelectedFavorite.IsHex}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <ListBox x:Name="FavoritesList" ItemsSource="{Binding Favorites}"
                                         SelectedItem="{Binding SelectedFavorite}"
                                         ItemContainerStyle="{StaticResource RowItem}"
                                         MouseDoubleClick="FavoritesList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <DockPanel Margin="0,2,0,0">
                                                    <Border x:Name="hexTag" DockPanel.Dock="Left" Style="{StaticResource HexTag}" Visibility="Collapsed">
                                                        <TextBlock Text="HEX" FontSize="10" Foreground="{StaticResource SubTextBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Data}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                               Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsHex}" Value="True">
                                                    <Setter TargetName="hexTag" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="かんたんマクロ">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                <StackPanel Margin="10,8,10,8">

                                    <TextBlock Text="繰り返し送信" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="入力欄の内容を、決まった間隔で送り続けます。" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBox Width="70" Text="{Binding RepeatIntervalText, UpdateSourceTrigger=PropertyChanged}"
                                                 HorizontalContentAlignment="Right" />
                                        <TextBlock Text="ミリ秒ごと" Style="{StaticResource FieldLabel}" Margin="6,0,10,0" />
                                        <Button Command="{Binding ToggleRepeatCommand}" MinWidth="72">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                                    <Setter Property="Content" Value="開始" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRepeating}" Value="True">
                                                            <Setter Property="Content" Value="停止" />
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="0,14" />

                                    <TextBlock Text="登録リストを順に送信" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="登録リストを上から1件ずつ、間をあけて送ります。" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBox Width="70" Text="{Binding SequenceIntervalText, UpdateSourceTrigger=PropertyChanged}"
                                                 HorizontalContentAlignment="Right" />
                                        <TextBlock Text="ミリ秒おき" Style="{StaticResource FieldLabel}" Margin="6,0,10,0" />
                                        <Button Command="{Binding ToggleSequenceCommand}" MinWidth="72">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                                    <Setter Property="Content" Value="実行" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSequenceRunning}" Value="True">
                                                            <Setter Property="Content" Value="停止" />
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                    <CheckBox Content="最後まで送ったら、先頭から繰り返す" Margin="0,8,0,0" IsChecked="{Binding SequenceLoop}" />

                                    <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="0,14" />

                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Content="有効" IsChecked="{Binding AutoReplyEnabled}" />
                                        <TextBlock Text="自動応答" Style="{StaticResource SectionTitle}" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Hint}" Text="受信した1件に指定の文字列が含まれていたら、決めた内容を送ります。" />

                                    <ItemsControl ItemsSource="{Binding AutoReplies}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,6" Padding="8,7" CornerRadius="8" Background="#F7F9FC"
                                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="5" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <CheckBox IsChecked="{Binding Enabled}" Margin="0,0,6,0" ToolTip="この決まりを使う" />
                                                        <DockPanel Grid.Column="1">
                                                            <TextBlock DockPanel.Dock="Right" Text="を含む" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />
                                                            <TextBox FontFamily="{StaticResource MonoFont}"
                                                                     Text="{Binding Contains, UpdateSourceTrigger=PropertyChanged}" />
                                                        </DockPanel>
                                                        <Button Grid.Column="2" Content="×" Style="{StaticResource SmallButton}" Margin="6,0,0,0" Padding="7,1"
                                                                ToolTip="この決まりを消す"
                                                                Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                        <TextBlock Grid.Row="2" Text="→" Foreground="{StaticResource FaintBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <DockPanel Grid.Row="2" Grid.Column="1">
                                                            <TextBlock DockPanel.Dock="Right" Text="を送る" Style="{StaticResource FieldLabel}" Margin="6,0,0,0" />
                                                            <TextBox FontFamily="{StaticResource MonoFont}"
                                                                     Text="{Binding Reply, UpdateSourceTrigger=PropertyChanged}" />
                                                        </DockPanel>
                                                        <CheckBox Grid.Row="2" Grid.Column="2" Content="HEX" Margin="6,0,0,0" IsChecked="{Binding ReplyIsHex}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="決まりを追加" Style="{StaticResource SmallButton}" HorizontalAlignment="Left"
                                            Command="{Binding AddRuleCommand}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>

                <!-- 右：ログと送信 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="ログ" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <CheckBox DockPanel.Dock="Left" Content="HEXで表示" IsChecked="{Binding ShowHex}" />
                                    <TextBlock DockPanel.Dock="Left" Text="受信の区切り" Style="{StaticResource FieldLabel}" Margin="18,0,6,0" />
                                    <ComboBox DockPanel.Dock="Left" Width="92" ItemsSource="{Binding ReceiveLineEndingChoices}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding ReceiveLineEnding}"
                                              ToolTip="受信をこの改行コードで1件ずつに区切ります。「時間だけ」は、続きが来なくなった時点で区切ります。" />
                                    <TextBlock DockPanel.Dock="Left" Text="無通信" Style="{StaticResource FieldLabel}" Margin="12,0,6,0" />
                                    <TextBox DockPanel.Dock="Left" Width="48" HorizontalContentAlignment="Right"
                                             Text="{Binding IdleTimeoutText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="この時間（ミリ秒）、続きが届かなければ、途中でも1件として確定します。" />
                                    <TextBlock DockPanel.Dock="Left" Text="ms" Style="{StaticResource FieldLabel}" Margin="5,0,0,0"
                                               ToolTip="この時間（ミリ秒）、続きが届かなければ、途中でも1件として確定します。" />

                                    <Button DockPanel.Dock="Right" Content="クリア" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                            Command="{Binding ClearLogCommand}" />
                                    <Button DockPanel.Dock="Right" Content="保存" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                            Click="SaveLog_Click" ToolTip="ログをテキストファイルへ保存します。" />
                                    <Button DockPanel.Dock="Right" Content="コピー" Style="{StaticResource SmallButton}" Margin="12,0,0,0"
                                            Click="CopyLog_Click" ToolTip="選んだ行をコピーします。選んでいなければ全部。" />
                                    <CheckBox DockPanel.Dock="Right" Content="最新を追う" IsChecked="{Binding AutoScroll}" Margin="14,0,0,0"
                                              ToolTip="新しい行が来たら、自動で一番下まで送ります。" />
                                </DockPanel>
                            </Border>

                            <ListBox x:Name="LogList" ItemsSource="{Binding Log}" SelectionMode="Extended"
                                     ItemContainerStyle="{StaticResource LogItem}" Margin="0,4,0,6"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     KeyDown="LogList_KeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource FaintBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                            <Border x:Name="badge" Grid.Column="1" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left"
                                                    VerticalAlignment="Top" Background="{StaticResource RxBgBrush}">
                                                <TextBlock x:Name="badgeText" Text="{Binding DirectionLabel}" FontSize="11"
                                                           Foreground="{StaticResource RxBrush}" />
                                            </Border>
                                            <TextBlock x:Name="body" Grid.Column="2" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"
                                                       VerticalAlignment="Top" Margin="0,1,0,0">
                                                <Run Text="{Binding Body, Mode=OneWay}" /><Run Text="{Binding Suffix, Mode=OneWay}"
                                                     Foreground="{StaticResource FaintBrush}" FontFamily="{StaticResource UiFont}" FontSize="11.5" />
                                            </TextBlock>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Direction}" Value="Sent">
                                                <Setter TargetName="badge" Property="Background" Value="{StaticResource TxBgBrush}" />
                                                <Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource TxBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Direction}" Value="Info">
                                                <Setter TargetName="badge" Property="Background" Value="{StaticResource InfoBgBrush}" />
                                                <Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                                <Setter TargetName="body" Property="Foreground" Value="{StaticResource SubTextBrush}" />
                                                <Setter TargetName="body" Property="FontFamily" Value="{StaticResource UiFont}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- 送信 -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,10">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="送信" Style="{StaticResource PrimaryButton}" MinWidth="84" Margin="8,0,0,0"
                                        Command="{Binding SendCommand}" ToolTip="Enterキーでも送信できます。" />
                                <ComboBox DockPanel.Dock="Right" Width="84" Margin="8,0,0,0" ItemsSource="{Binding SendLineEndingChoices}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SendLineEnding}"
                                          ToolTip="文字列の末尾に足す改行コード。HEXのときは足しません。" />
                                <CheckBox DockPanel.Dock="Right" Content="HEX" Margin="10,0,0,0" IsChecked="{Binding SendAsHex}"
                                          ToolTip="入力を16進数として送ります（例：02 41 03）。" />
                                <TextBox x:Name="SendBox" FontFamily="{StaticResource MonoFont}" FontSize="14" MinHeight="34"
                                         Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="SendBox_PreviewKeyDown">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SendCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0" LastChildFill="False">
                                <CheckBox DockPanel.Dock="Left" Content="送信したら入力欄を空にする" IsChecked="{Binding ClearInputAfterSend}" />
                                <Button DockPanel.Dock="Left" Content="登録リストへ追加" Style="{StaticResource SmallButton}" Margin="14,0,0,0"
                                        Command="{Binding AddFavoriteCommand}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CounterText}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 下：知らせ -->
            <TextBlock Grid.Row="2" Margin="4,8,4,0" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding StatusMessage}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
